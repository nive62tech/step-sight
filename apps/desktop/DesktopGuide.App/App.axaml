<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="DesktopGuide.App.App" RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style Selector="Button"><Setter Property="MinHeight" Value="38" /><Setter Property="CornerRadius" Value="8" /></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="8" /></Style>
  </Application.Styles>
</Application>
