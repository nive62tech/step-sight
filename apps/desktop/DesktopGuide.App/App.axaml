<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="DesktopGuide.App.App" RequestedThemeVariant="Light">
  <Application.Resources>
    <SolidColorBrush x:Key="ModeBackground" Color="#EDF8F0" />
    <SolidColorBrush x:Key="ModeForeground" Color="#153D29" />
    <SolidColorBrush x:Key="ModeSurface" Color="#F8FFF9" />
    <SolidColorBrush x:Key="ModeSecondary" Color="#DDEFE2" />
    <SolidColorBrush x:Key="ModeBorder" Color="#BCD8C5" />
    <SolidColorBrush x:Key="ModeAccent" Color="#167247" />
    <SolidColorBrush x:Key="ModeMuted" Color="#526F5D" />
    <SolidColorBrush x:Key="ModeNotice" Color="#E3F2DD" />
    <SolidColorBrush x:Key="ModeNoticeBorder" Color="#B9D3AC" />
    <SolidColorBrush x:Key="ModeHover" Color="#218957" />
    <SolidColorBrush x:Key="ModeDark" Color="#0B2115" />
    <SolidColorBrush x:Key="ModeDarkSurface" Color="#152F20" />
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window"><Setter Property="Background" Value="{DynamicResource ModeBackground}" /><Setter Property="Foreground" Value="{DynamicResource ModeForeground}" /></Style>
    <Style Selector="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Foreground" Value="{DynamicResource ModeForeground}" /></Style>
    <Style Selector="TextBlock.title"><Setter Property="FontFamily" Value="Georgia" /><Setter Property="FontSize" Value="38" /><Setter Property="LineHeight" Value="46" /></Style>
    <Style Selector="TextBlock.section"><Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource ModeMuted}" /></Style>
    <Style Selector="TextBlock.accent"><Setter Property="Foreground" Value="{DynamicResource ModeAccent}" /></Style>
    <Style Selector="Border.header"><Setter Property="Background" Value="{DynamicResource ModeSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource ModeBorder}" /><Setter Property="BorderThickness" Value="0,0,0,1" /></Style>
    <Style Selector="Border.sidebar"><Setter Property="Background" Value="{DynamicResource ModeSecondary}" /><Setter Property="BorderBrush" Value="{DynamicResource ModeBorder}" /><Setter Property="BorderThickness" Value="0,0,1,0" /></Style>
    <Style Selector="Border.footer"><Setter Property="Background" Value="{DynamicResource ModeSecondary}" /><Setter Property="BorderBrush" Value="{DynamicResource ModeBorder}" /><Setter Property="BorderThickness" Value="0,1,0,0" /></Style>
    <Style Selector="Border.surface"><Setter Property="Background" Value="{DynamicResource ModeSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource ModeBorder}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" /></Style>
    <Style Selector="Border.notice"><Setter Property="Background" Value="{DynamicResource ModeNotice}" /><Setter Property="BorderBrush" Value="{DynamicResource ModeNoticeBorder}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="9" /></Style>
    <Style Selector="Button"><Setter Property="MinHeight" Value="42" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="16,10" /><Setter Property="Foreground" Value="{DynamicResource ModeAccent}" /><Setter Property="BorderBrush" Value="{DynamicResource ModeBorder}" /><Setter Property="Background" Value="{DynamicResource ModeSurface}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="{DynamicResource ModeAccent}" /><Setter Property="Foreground" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="{DynamicResource ModeAccent}" /></Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource ModeHover}" /></Style>
    <Style Selector="Button.quiet"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
    <Style Selector="Button.blob:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
    <Style Selector="Button.blob:pressed /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
    <Style Selector="ToggleSwitch"><Setter Property="Foreground" Value="{DynamicResource ModeForeground}" /></Style>
    <Style Selector="Button.nav"><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
    <Style Selector="Button.nav.selected"><Setter Property="Background" Value="{DynamicResource ModeSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource ModeBorder}" /></Style>
    <Style Selector="Button.danger"><Setter Property="Background" Value="{DynamicResource ModeSecondary}" /><Setter Property="Foreground" Value="{DynamicResource ModeAccent}" /><Setter Property="BorderBrush" Value="{DynamicResource ModeBorder}" /></Style>
    <Style Selector="TextBox"><Setter Property="MinHeight" Value="44" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Background" Value="{DynamicResource ModeSurface}" /><Setter Property="Foreground" Value="{DynamicResource ModeForeground}" /><Setter Property="BorderBrush" Value="{DynamicResource ModeBorder}" /><Setter Property="Padding" Value="12,10" /></Style>
    <Style Selector="ComboBox"><Setter Property="MinHeight" Value="44" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Background" Value="{DynamicResource ModeSurface}" /><Setter Property="Foreground" Value="{DynamicResource ModeForeground}" /><Setter Property="BorderBrush" Value="{DynamicResource ModeBorder}" /></Style>
    <Style Selector="CheckBox"><Setter Property="Foreground" Value="{DynamicResource ModeForeground}" /></Style>
    <Style Selector="ListBox.lessons"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="ListBox.lessons ListBoxItem"><Setter Property="Background" Value="{DynamicResource ModeSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource ModeBorder}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="16" /><Setter Property="Margin" Value="0,0,8,8" /><Setter Property="MinHeight" Value="104" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
    <Style Selector="ListBox.lessons ListBoxItem:selected"><Setter Property="Background" Value="{DynamicResource ModeSecondary}" /><Setter Property="BorderBrush" Value="{DynamicResource ModeAccent}" /></Style>
    <Style Selector="ListBox.lessons ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource ModeSecondary}" /></Style>
  </Application.Styles>
</Application>
