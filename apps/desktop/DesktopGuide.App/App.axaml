<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="DesktopGuide.App.App" RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window"><Setter Property="Background" Value="#F5F4EE" /><Setter Property="Foreground" Value="#193B34" /></Style>
    <Style Selector="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Foreground" Value="#193B34" /></Style>
    <Style Selector="TextBlock.title"><Setter Property="FontFamily" Value="Georgia" /><Setter Property="FontSize" Value="38" /><Setter Property="LineHeight" Value="46" /></Style>
    <Style Selector="TextBlock.section"><Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#546660" /></Style>
    <Style Selector="TextBlock.accent"><Setter Property="Foreground" Value="#306252" /></Style>
    <Style Selector="Border.header"><Setter Property="Background" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="#DFE3DA" /><Setter Property="BorderThickness" Value="0,0,0,1" /></Style>
    <Style Selector="Border.sidebar"><Setter Property="Background" Value="#EBEEE5" /><Setter Property="BorderBrush" Value="#DDE2D6" /><Setter Property="BorderThickness" Value="0,0,1,0" /></Style>
    <Style Selector="Border.footer"><Setter Property="Background" Value="#EBEEE5" /><Setter Property="BorderBrush" Value="#DDE2D6" /><Setter Property="BorderThickness" Value="0,1,0,0" /></Style>
    <Style Selector="Border.surface"><Setter Property="Background" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="#DFE5DA" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" /></Style>
    <Style Selector="Border.notice"><Setter Property="Background" Value="#F8EBDD" /><Setter Property="BorderBrush" Value="#E2C7AC" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="9" /></Style>
    <Style Selector="Button"><Setter Property="MinHeight" Value="42" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="16,10" /><Setter Property="Foreground" Value="#214C40" /><Setter Property="BorderBrush" Value="#CCD8CF" /><Setter Property="Background" Value="#FFFFFF" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#214C40" /><Setter Property="Foreground" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="#214C40" /></Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#2E6656" /></Style>
    <Style Selector="Button.quiet"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
    <Style Selector="Button.nav"><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
    <Style Selector="Button.nav.selected"><Setter Property="Background" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="#D5DFD3" /></Style>
    <Style Selector="Button.danger"><Setter Property="Background" Value="#F6E6DE" /><Setter Property="Foreground" Value="#883D2D" /><Setter Property="BorderBrush" Value="#E6C9BB" /></Style>
    <Style Selector="TextBox"><Setter Property="MinHeight" Value="44" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Background" Value="#FFFFFF" /><Setter Property="Foreground" Value="#193B34" /><Setter Property="BorderBrush" Value="#CBD7CC" /><Setter Property="Padding" Value="12,10" /></Style>
    <Style Selector="ComboBox"><Setter Property="MinHeight" Value="44" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Background" Value="#FFFFFF" /><Setter Property="Foreground" Value="#193B34" /><Setter Property="BorderBrush" Value="#CBD7CC" /></Style>
    <Style Selector="CheckBox"><Setter Property="Foreground" Value="#193B34" /></Style>
    <Style Selector="ListBox.lessons"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="ListBox.lessons ListBoxItem"><Setter Property="Background" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="#DFE5DA" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="16" /><Setter Property="Margin" Value="0,0,8,8" /><Setter Property="MinHeight" Value="104" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
    <Style Selector="ListBox.lessons ListBoxItem:selected"><Setter Property="Background" Value="#E3EBDD" /><Setter Property="BorderBrush" Value="#306252" /></Style>
    <Style Selector="ListBox.lessons ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="#E3EBDD" /></Style>
  </Application.Styles>
</Application>
