{
  "$defs": {
    "RemoteCommand": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "start",
            "pause",
            "resume",
            "stop",
            "check"
          ],
          "title": "Kind",
          "type": "string"
        },
        "mode": {
          "anyOf": [
            {
              "enum": [
                "guide",
                "autonomous"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mode"
        },
        "goal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Goal"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "mode",
        "goal",
        "expires_at"
      ],
      "title": "RemoteCommand",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "command": {
      "anyOf": [
        {
          "$ref": "#/$defs/RemoteCommand"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "command"
  ],
  "title": "RemotePollResponse",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://desktop-guide.invalid/contracts/v1/RemotePollResponse.schema.json"
}
