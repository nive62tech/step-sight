{
  "$defs": {
    "Bounds": {
      "additionalProperties": false,
      "properties": {
        "left": {
          "maximum": 1,
          "minimum": 0,
          "title": "Left",
          "type": "number"
        },
        "top": {
          "maximum": 1,
          "minimum": 0,
          "title": "Top",
          "type": "number"
        },
        "right": {
          "maximum": 1,
          "minimum": 0,
          "title": "Right",
          "type": "number"
        },
        "bottom": {
          "maximum": 1,
          "minimum": 0,
          "title": "Bottom",
          "type": "number"
        }
      },
      "required": [
        "left",
        "top",
        "right",
        "bottom"
      ],
      "title": "Bounds",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "format": "uuid",
          "title": "Observation Id",
          "type": "string"
        },
        "detail": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "observation_id",
        "detail"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "GuidanceStep": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "source_observation_id": {
          "format": "uuid",
          "title": "Source Observation Id",
          "type": "string"
        },
        "instruction": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Instruction",
          "type": "string"
        },
        "explanation": {
          "maxLength": 1500,
          "title": "Explanation",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/Target"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "expected_user_action": {
          "enum": [
            "click",
            "type",
            "scroll",
            "key_chord",
            "manual",
            "wait"
          ],
          "title": "Expected User Action",
          "type": "string"
        },
        "postconditions": {
          "items": {
            "$ref": "#/$defs/Postcondition"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Postconditions",
          "type": "array"
        },
        "hints": {
          "items": {
            "maxLength": 500,
            "type": "string"
          },
          "maxItems": 5,
          "title": "Hints",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "uncertainty": {
          "items": {
            "maxLength": 500,
            "type": "string"
          },
          "maxItems": 5,
          "title": "Uncertainty",
          "type": "array"
        }
      },
      "required": [
        "id",
        "source_observation_id",
        "instruction",
        "explanation",
        "expected_user_action",
        "postconditions",
        "evidence"
      ],
      "title": "GuidanceStep",
      "type": "object"
    },
    "Mode": {
      "enum": [
        "guide",
        "demonstrate",
        "practice",
        "autonomous"
      ],
      "title": "Mode",
      "type": "string"
    },
    "Postcondition": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "visible_text",
            "visible_state"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "Postcondition",
      "type": "object"
    },
    "Target": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "rectangle",
          "default": "rectangle",
          "title": "Kind",
          "type": "string"
        },
        "coordinate_space": {
          "const": "normalized_source_image",
          "default": "normalized_source_image",
          "title": "Coordinate Space",
          "type": "string"
        },
        "geometry_id": {
          "format": "uuid",
          "title": "Geometry Id",
          "type": "string"
        },
        "bounds": {
          "$ref": "#/$defs/Bounds"
        },
        "visible_label": {
          "maxLength": 200,
          "title": "Visible Label",
          "type": "string"
        }
      },
      "required": [
        "geometry_id",
        "bounds",
        "visible_label"
      ],
      "title": "Target",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "device_id": {
      "format": "uuid",
      "title": "Device Id",
      "type": "string"
    },
    "goal": {
      "title": "Goal",
      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/Mode"
    },
    "language": {
      "title": "Language",
      "type": "string"
    },
    "detail_level": {
      "title": "Detail Level",
      "type": "string"
    },
    "scope_id": {
      "format": "uuid",
      "title": "Scope Id",
      "type": "string"
    },
    "session_version": {
      "title": "Session Version",
      "type": "integer"
    },
    "state": {
      "title": "State",
      "type": "string"
    },
    "lesson_id": {
      "title": "Lesson Id",
      "type": "string"
    },
    "saved_progress": {
      "title": "Saved Progress",
      "type": "boolean"
    },
    "completed_steps": {
      "title": "Completed Steps",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "provider": {
      "enum": [
        "mock",
        "gemini"
      ],
      "title": "Provider",
      "type": "string"
    },
    "pending_step": {
      "anyOf": [
        {
          "$ref": "#/$defs/GuidanceStep"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "device_id",
    "goal",
    "mode",
    "language",
    "detail_level",
    "scope_id",
    "session_version",
    "state",
    "lesson_id",
    "saved_progress",
    "completed_steps",
    "created_at",
    "provider"
  ],
  "title": "SessionView",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://desktop-guide.invalid/contracts/v1/SessionView.schema.json"
}
